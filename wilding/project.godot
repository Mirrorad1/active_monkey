config_version=5

[application]
config/name="Wilding"
run/main_scene="res://Main.tscn"
config/features=PackedStringArray("4.7", "C#", "GL Compatibility")

[display]
window/size/viewport_width=1280
window/size/viewport_height=960
window/size/window_width_override=1280
window/size/window_height_override=960
window/size/min_width=1000
window/size/min_height=760
window/stretch/mode="canvas_items"

[dotnet]
project/assembly_name="Wilding"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.69, 0.83, 0.85, 1)
